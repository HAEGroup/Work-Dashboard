# Server environment (used for local development)
NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/work_dashboard

JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/google/callback

# Rentvine (can also be configured via Settings UI)
RENTVINE_API_KEY=
RENTVINE_API_SECRET=
RENTVINE_BASE_URL=https://api.rentvine.com

# System SMTP (for password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

CLIENT_URL=http://localhost:5173
