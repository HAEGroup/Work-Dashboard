generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  emailAccounts       EmailAccount[]
  calendarEvents      CalendarEvent[]
  taskAssignments     TaskAssignment[]
  timeEntries         TimeEntry[]
  journalEntries      JournalEntry[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  crmActivities       CrmActivity[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([token])
  @@map("password_reset_tokens")
}

model SmtpConfig {
  id       String @id @default(uuid())
  host     String
  port     Int    @default(587)
  username String
  password String
  fromEmail String @map("from_email")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("smtp_config")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============================================================
// EMAIL
// ============================================================

model EmailAccount {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  label        String
  emailAddress String  @map("email_address")
  imapHost     String  @map("imap_host")
  imapPort     Int     @default(993) @map("imap_port")
  smtpHost     String  @map("smtp_host")
  smtpPort     Int     @default(587) @map("smtp_port")
  username     String
  password     String  // encrypted at application level
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User          @relation(fields: [userId], references: [id])
  emails EmailMessage[]

  @@map("email_accounts")
}

model EmailMessage {
  id             String   @id @default(uuid())
  accountId      String   @map("account_id")
  messageId      String?  @map("message_id")
  folder         String   @default("INBOX")
  fromAddress    String   @map("from_address")
  fromName       String?  @map("from_name")
  toAddresses    Json     @map("to_addresses")
  ccAddresses    Json?    @map("cc_addresses")
  subject        String?
  bodyText       String?  @map("body_text")
  bodyHtml       String?  @map("body_html")
  isRead         Boolean  @default(false) @map("is_read")
  isStarred      Boolean  @default(false) @map("is_starred")
  hasAttachments Boolean  @default(false) @map("has_attachments")
  date           DateTime
  uid            Int?

  createdAt DateTime @default(now()) @map("created_at")

  account     EmailAccount      @relation(fields: [accountId], references: [id])
  attachments EmailAttachment[]

  @@unique([accountId, uid, folder])
  @@index([accountId, folder])
  @@index([date])
  @@map("email_messages")
}

model EmailAttachment {
  id        String @id @default(uuid())
  emailId   String @map("email_id")
  filename  String
  mimeType  String @map("mime_type")
  size      Int
  storagePath String @map("storage_path")

  email EmailMessage @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@map("email_attachments")
}

// ============================================================
// CALENDAR
// ============================================================

model CalendarEvent {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  title           String
  description     String?
  location        String?
  startTime       DateTime  @map("start_time")
  endTime         DateTime  @map("end_time")
  allDay          Boolean   @default(false) @map("all_day")
  recurrenceRule  String?   @map("recurrence_rule")
  color           String?
  googleEventId   String?   @map("google_event_id")
  googleCalendarId String?  @map("google_calendar_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, startTime, endTime])
  @@index([googleEventId])
  @@map("calendar_events")
}

model GoogleCalendarSync {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  accessToken   String   @map("access_token")
  refreshToken  String   @map("refresh_token")
  tokenExpiry   DateTime @map("token_expiry")
  calendarId    String   @default("primary") @map("calendar_id")
  syncToken     String?  @map("sync_token")
  lastSyncAt    DateTime? @map("last_sync_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("google_calendar_sync")
}

// ============================================================
// ACCOUNTING (Double-Entry, Multi-Entity)
// ============================================================

model Entity {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts       Account[]
  journalEntries JournalEntry[]

  @@map("entities")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id          String      @id @default(uuid())
  entityId    String      @map("entity_id")
  code        String
  name        String
  type        AccountType
  parentId    String?     @map("parent_id")
  description String?
  isActive    Boolean     @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entity   Entity        @relation(fields: [entityId], references: [id])
  parent   Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[]     @relation("AccountHierarchy")
  lines    JournalLine[]

  @@unique([entityId, code])
  @@map("accounts")
}

model JournalEntry {
  id          String   @id @default(uuid())
  entityId    String   @map("entity_id")
  userId      String   @map("user_id")
  date        DateTime
  reference   String?
  description String
  isPosted    Boolean  @default(false) @map("is_posted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entity Entity        @relation(fields: [entityId], references: [id])
  user   User          @relation(fields: [userId], references: [id])
  lines  JournalLine[]

  @@index([entityId, date])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(uuid())
  journalEntryId String  @map("journal_entry_id")
  accountId      String  @map("account_id")
  debit          Decimal @default(0) @db.Decimal(15, 2)
  credit         Decimal @default(0) @db.Decimal(15, 2)
  description    String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("journal_lines")
}

// ============================================================
// TASKS & PROJECT MANAGEMENT
// ============================================================

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?
  color       String?
  isArchived  Boolean @default(false) @map("is_archived")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tasks Task[]

  @@map("projects")
}

model Task {
  id          String       @id @default(uuid())
  projectId   String?      @map("project_id")
  parentId    String?      @map("parent_id")
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")
  startDate   DateTime?    @map("start_date")
  estimatedHours Float?    @map("estimated_hours")
  sortOrder   Int          @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project      Project?         @relation(fields: [projectId], references: [id])
  parent       Task?            @relation("TaskHierarchy", fields: [parentId], references: [id])
  children     Task[]           @relation("TaskHierarchy")
  assignments  TaskAssignment[]
  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("DependsOnTask")
  timeEntries  TimeEntry[]

  @@index([projectId, status])
  @@index([parentId])
  @@map("tasks")
}

model TaskAssignment {
  id     String @id @default(uuid())
  taskId String @map("task_id")
  userId String @map("user_id")

  assignedAt DateTime @default(now()) @map("assigned_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@map("task_assignments")
}

model TaskDependency {
  id           String @id @default(uuid())
  taskId       String @map("task_id")
  dependsOnId  String @map("depends_on_id")

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependsOnTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@map("task_dependencies")
}

model TimeEntry {
  id          String    @id @default(uuid())
  taskId      String    @map("task_id")
  userId      String    @map("user_id")
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId, startTime])
  @@map("time_entries")
}

// ============================================================
// RENTVINE INTEGRATION
// ============================================================

model RentvineConfig {
  id           String  @id @default(uuid())
  apiKey       String  @map("api_key")
  apiSecret    String  @map("api_secret")
  baseUrl      String  @default("https://api.rentvine.com") @map("base_url")
  isActive     Boolean @default(true) @map("is_active")
  lastSyncAt   DateTime? @map("last_sync_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rentvine_config")
}

model RentvineProperty {
  id               String  @id @default(uuid())
  rentvineId       String  @unique @map("rentvine_id")
  name             String
  address          String?
  city             String?
  state            String?
  zip              String?
  type             String?
  status           String?
  ownerId          String? @map("owner_id")
  ownerName        String? @map("owner_name")
  entityId         String? @map("entity_id")
  rawData          Json?   @map("raw_data")

  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  units              RentvineUnit[]
  tenants            RentvineTenant[]
  maintenanceRequests RentvineMaintenanceRequest[]

  @@map("rentvine_properties")
}

model RentvineUnit {
  id          String  @id @default(uuid())
  rentvineId  String  @unique @map("rentvine_id")
  propertyId  String  @map("property_id")
  name        String
  bedrooms    Int?
  bathrooms   Float?
  sqft        Int?
  rent        Decimal? @db.Decimal(10, 2)
  status      String?
  rawData     Json?   @map("raw_data")

  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  property RentvineProperty @relation(fields: [propertyId], references: [id])
  tenants  RentvineTenant[]

  @@map("rentvine_units")
}

model RentvineTenant {
  id          String  @id @default(uuid())
  rentvineId  String  @unique @map("rentvine_id")
  propertyId  String  @map("property_id")
  unitId      String? @map("unit_id")
  firstName   String  @map("first_name")
  lastName    String  @map("last_name")
  email       String?
  phone       String?
  leaseStart  DateTime? @map("lease_start")
  leaseEnd    DateTime? @map("lease_end")
  rentAmount  Decimal?  @db.Decimal(10, 2) @map("rent_amount")
  status      String?
  rawData     Json?   @map("raw_data")

  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  property RentvineProperty @relation(fields: [propertyId], references: [id])
  unit     RentvineUnit?    @relation(fields: [unitId], references: [id])

  @@map("rentvine_tenants")
}

model RentvineMaintenanceRequest {
  id          String   @id @default(uuid())
  rentvineId  String   @unique @map("rentvine_id")
  propertyId  String   @map("property_id")
  title       String
  description String?
  status      String?
  priority    String?
  requestedBy String?  @map("requested_by")
  assignedTo  String?  @map("assigned_to")
  rawData     Json?    @map("raw_data")

  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  property RentvineProperty @relation(fields: [propertyId], references: [id])

  @@map("rentvine_maintenance_requests")
}

model RentvineTransaction {
  id          String   @id @default(uuid())
  rentvineId  String   @unique @map("rentvine_id")
  propertyId  String?  @map("property_id")
  type        String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime
  description String?
  category    String?
  status      String?
  rawData     Json?    @map("raw_data")

  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("rentvine_transactions")
}

// ============================================================
// CRM (Monday.com-style boards)
// ============================================================

enum CrmColumnType {
  TEXT
  NUMBER
  STATUS
  DATE
  PERSON
  EMAIL
  PHONE
  LINK
  DROPDOWN
  CHECKBOX
  RATING
}

model CrmBoard {
  id          String  @id @default(uuid())
  name        String
  description String?
  color       String  @default("#3b82f6")
  icon        String  @default("layout-grid")
  position    Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  groups  CrmGroup[]
  columns CrmColumn[]

  @@map("crm_boards")
}

model CrmColumn {
  id       String        @id @default(uuid())
  boardId  String        @map("board_id")
  name     String
  type     CrmColumnType
  config   Json?
  width    Int           @default(150)
  position Int           @default(0)

  board      CrmBoard       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cellValues CrmCellValue[]

  @@map("crm_columns")
}

model CrmGroup {
  id        String  @id @default(uuid())
  boardId   String  @map("board_id")
  name      String
  color     String  @default("#3b82f6")
  position  Int     @default(0)
  collapsed Boolean @default(false)

  board CrmBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  items CrmItem[]

  @@map("crm_groups")
}

model CrmItem {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group      CrmGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cellValues CrmCellValue[]
  activities CrmActivity[]

  @@map("crm_items")
}

model CrmCellValue {
  id       String @id @default(uuid())
  itemId   String @map("item_id")
  columnId String @map("column_id")
  value    Json

  item   CrmItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  column CrmColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@unique([itemId, columnId])
  @@map("crm_cell_values")
}

model CrmActivity {
  id       String   @id @default(uuid())
  itemId   String   @map("item_id")
  userId   String   @map("user_id")
  type     String
  content  String
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")

  item CrmItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id])

  @@index([itemId])
  @@map("crm_activities")
}
